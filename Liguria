                    <li>Il personale preposto alla gestione della Foresteria consulta periodicamente il registro e sottopone le segnalazioni al Comandante del Battaglione.</li>
                </ol> 
            </div> 

            <div class="lang-content lang-en"> 
                <h4 style="color: var(--blu-arma); margin-top: 0; margin-bottom: 15px; font-size: 18px;">CONSULTATION AND COMPILATION NOTES:</h4>
                <ol style="padding-left: 20px; font-size: 15px; color: #475569; margin-bottom: 25px; line-height: 1.8;"> 
                    <li style="margin-bottom: 12px;">This registry is available to guests to collect suggestions aimed at improving the services offered or to report any disservices encountered during the stay.</li>
                    <li style="margin-bottom: 12px;">Reports can be made nominally or anonymously. Providing contact details will allow the Command to provide feedback on the actions taken.</li>
                    <li>The staff responsible for managing the Guesthouse periodically consults the registry and submits the reports to the Battalion Commander.</li>
                </ol> 
            </div> 

            <!-- PULSANTE REGISTRO --> 
            <div style="background: #f8fafc; padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0;">
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <a href="https://docs.google.com/forms/d/e/1FAIpQLSfdpP2hEG78SgSebS-xEoPZks3k2cesMAxpDmYh03bUqrRbmg/viewform" target="_blank" class="btn btn-call" style="margin:0; flex:1; justify-content:center; text-align:center; padding: 14px; font-size: 15px;">
                        <span class="lang-content lang-it">✍️ Apri e Compila il Registro</span>
                        <span class="lang-content lang-en">✍️ Open and Fill out the Registry</span>
                    </a> 
                </div> 
            </div> 
        </div> 

        <!-- EASTER EGG --> 
        <div style="text-align: center; font-size: 3px; color: #f1f5f9; margin-top: 20px; user-select: none;">
            B.C. Pirozzi 2° BTG LIGURIA
        </div> 

    </div> 

    <!-- MODALE FINASTRA ZOOM IMMAGINI -->
    <div id="imageModal" class="image-modal" onclick="closeModal()">
        <span class="image-modal-close" onclick="closeModal()">&times;</span>
        <img class="image-modal-content" id="modalImg">
        <div class="zoom-hint">🔍 Clicca o usa due dita per ingrandire / Clicca altrove per chiudere</div>
    </div>

    <!-- Script Cambio Lingua, Animazione Mappa, Trenitalia, Copia, Meteo e Notizie TG24 --> 
    <script> 
        let currentLang = 'it'; 
        function setLanguage(lang) { 
            currentLang = lang; 
            const allContent = document.querySelectorAll('.lang-content'); 
            allContent.forEach(el => el.style.display = 'none'); 
            const selectedContent = document.querySelectorAll('.lang-' + lang); 
            selectedContent.forEach(el => { 
                if(el.tagName.toLowerCase() === 'span') { el.style.display = 'inline'; } 
                else { el.style.display = 'block'; } 
            }); 
            const buttons = document.querySelectorAll('.lang-btn'); 
            buttons.forEach(btn => btn.classList.remove('active')); 
            document.getElementById('btn-' + lang).classList.add('active'); 
        } 

        // ANIMAZIONE PERCORSI MAPPA CASERMA
        function animatePath(type) {
            const routeBar = document.getElementById('routeBar');
            const routeATM = document.getElementById('routeATM');
            const routeGym = document.getElementById('routeGym');
            const pinBar = document.getElementById('pinBar');
            const pinATM = document.getElementById('pinATM');
            const pinGym = document.getElementById('pinGym');

            // Reset visibilità
            routeBar.style.display = 'none';
            routeATM.style.display = 'none';
            routeGym.style.display = 'none';
            routeBar.classList.remove('active');
            routeATM.classList.remove('active');
            routeGym.classList.remove('active');
            pinBar.classList.remove('highlighted');
            pinATM.classList.remove('highlighted');
            pinGym.classList.remove('highlighted');

            if (type === 'bar') {
                routeBar.style.display = 'block';
                setTimeout(() => { routeBar.classList.add('active'); }, 50);
                pinBar.classList.add('highlighted');
            } else if (type === 'atm') {
                routeATM.style.display = 'block';
                setTimeout(() => { routeATM.classList.add('active'); }, 50);
                pinATM.classList.add('highlighted');
            } else if (type === 'gym') {
                routeGym.style.display = 'block';
                setTimeout(() => { routeGym.classList.add('active'); }, 50);
                pinGym.classList.add('highlighted');
            }
        }

        // Generatore reindirizzamento diretto a Trenitalia
        function openTrain(destinationStation) {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const hour = String(now.getHours()).padStart(2, '0');
            
            const originStation = "Genova Sturla";
            let url = "";

            if (!destinationStation) {
                url = `https://www.trenitalia.com/it/informazioni/cerca_e_acquista.html?stazionePartenza=${encodeURIComponent(originStation)}`;
            } else {
                url = `https://www.trenitalia.com/it/informazioni/cerca_e_acquista.html?stazionePartenza=${encodeURIComponent(originStation)}&stazioneArrivo=${encodeURIComponent(destinationStation)}&dataPartenza=${day}%2F${month}%2F${year}&oraPartenza=${hour}`;
            }
            
            window.open(url, '_blank');
        }

        // Funzione Copia negli Appunti
        function copyToClipboard(elementId, buttonEl) {
            const textToCopy = document.getElementById(elementId).innerText;
            navigator.clipboard.writeText(textToCopy).then(() => {
                const originalText = buttonEl.innerText;
                buttonEl.innerText = "✓ Copiato!";
                buttonEl.style.backgroundColor = "#16a34a";
                setTimeout(() => {
                    buttonEl.innerText = originalText;
                    buttonEl.style.backgroundColor = "#334155";
                }, 2000);
            }).catch(err => {
                alert("Impossibile copiare il testo.");
            });
        }

        // Gestione Zoom Immagine (Lightbox Modal)
        function openModal(imgSrc) {
            const modal = document.getElementById("imageModal");
            const modalImg = document.getElementById("modalImg");
            modal.style.display = "flex";
            modalImg.src = imgSrc;
        }

        function closeModal() {
            document.getElementById("imageModal").style.display = "none";
        }

        // Meteo 
        async function loadLiveWeather() { 
            try { 
                const res = await fetch('https://api.open-meteo.com/v1/forecast?latitude=44.4056&longitude=8.9463&current_weather=true'); 
                const data = await res.json(); 
                
                if (data && data.current_weather) { 
                    const temp = Math.round(data.current_weather.temperature); 
                    const code = data.current_weather.weathercode; 
                    
                    document.getElementById('weather-temp').innerText = temp + '°C'; 
                    
                    let icon = '☀️'; 
                    let text = 'Sereno'; 
                    
                    if (code >= 1 && code <= 3) { icon = '⛅'; text = 'Poco Nuvoloso'; } 
                    else if (code >= 45 && code <= 48) { icon = '🌫️'; text = 'Nebbia'; } 
                    else if (code >= 51 && code <= 67) { icon = '🌧️'; text = 'Pioggia'; } 
                    else if (code >= 71 && code <= 77) { icon = '❄️'; text = 'Neve'; } 
                    else if (code >= 80 && code <= 82) { icon = '🌦️'; text = 'Rovesci'; } 
                    else if (code >= 95) { icon = '⛈️'; text = 'Temporale'; } 
                    
                    document.getElementById('weather-icon').innerText = icon; 
                    document.getElementById('weather-status').innerText = text; 
                } 
            } catch (e) { 
                document.getElementById('weather-icon').innerText = '☀️'; 
                document.getElementById('weather-temp').innerText = '22°C'; 
                document.getElementById('weather-status').innerText = 'Sereno'; 
            } 
        } 

        // NOTIZIE TG24 IN TEMPO REALE GARANTITE
        let currentNewsIndex = 0;
        let totalNewsCount = 0;
        let newsAutoTimer;

        // Lista notizie statiche/fallback per garantire la visualizzazione istantanea
        const fallbackNews = [
            {
                title: "Notizie Italia & Mondo - Diretta Sky TG24",
                desc: "Segui le ultime notizie di cronaca, politica, economia ed esteri aggiornate 24 ore su 24.",
                link: "https://tg24.sky.it/"
            },
            {
                title: "Previsioni Meteo e Allerte Nazionali",
                desc: "Consulta la situazione meteorologica aggiornata e i bollettini ufficiali della protezione civile.",
                link: "https://tg24.sky.it/meteo"
            },
            {
                title: "Mobilità e Trasporti in Italia",
                desc: "Tutti gli aggiornamenti su traffico, orari dei treni e collegamenti nazionali in tempo reale.",
                link: "https://tg24.sky.it/cronaca"
            }
        ];

        async function loadLiveNews() {
            const carousel = document.getElementById('newsCarousel');
            try {
                // Fetch via AllOrigins per superare i blocchi CORS
                const res = await fetch('https://api.allorigins.win/get?url=' + encodeURIComponent('https://sky.it/rss/skytg24_italia.xml'));
                const data = await res.json();

                if (data && data.contents) {
                    const parser = new DOMParser();
                    const xmlDoc = parser.parseFromString(data.contents, "text/xml");
                    const items = xmlDoc.querySelectorAll("item");

                    if (items.length > 0) {
                        carousel.innerHTML = '';
                        totalNewsCount = items.length;

                        items.forEach((item) => {
                            const title = item.querySelector("title") ? item.querySelector("title").textContent : "";
                            const link = item.querySelector("link") ? item.querySelector("link").textContent : "https://tg24.sky.it/";
                            let desc = item.querySelector("description") ? item.querySelector("description").textContent : "";
                            desc = desc.replace(/<[^>]*>?/gm, '').substring(0, 140) + "...";

                            const newsDiv = document.createElement('div');
                            newsDiv.className = 'news-card-item';
                            newsDiv.innerHTML = `
                                <div class="news-item-title">${title}</div>
                                <div class="news-item-desc">${desc}</div>
                                <a href="${link}" target="_blank" class="news-item-link">🌐 Leggi l'articolo completo su Sky TG24 ➔</a>
                            `;
                            carousel.appendChild(newsDiv);
                        });

                        startNewsAutoScroll();
                        return;
                    }
                }
                throw new Error("RSS non caricato");
            } catch (e) {
                // Caricamento schede interattive di backup trasparenti
                carousel.innerHTML = '';
                totalNewsCount = fallbackNews.length;
                fallbackNews.forEach((item) => {
                    const newsDiv = document.createElement('div');
                    newsDiv.className = 'news-card-item';
                    newsDiv.innerHTML = `
                        <div class="news-item-title">${item.title}</div>
                        <div class="news-item-desc">${item.desc}</div>
                        <a href="${item.link}" target="_blank" class="news-item-link">🌐 Apri il portale Sky TG24 ➔</a>
                    `;
                    carousel.appendChild(newsDiv);
                });
                startNewsAutoScroll();
            }
        }

        function scrollToNews(index) {
            const carousel = document.getElementById('newsCarousel');
            if (totalNewsCount > 0) {
                if (index < 0) index = totalNewsCount - 1;
                if (index >= totalNewsCount) index = 0;
                currentNewsIndex = index;
                const cardWidth = carousel.querySelector('.news-card-item').offsetWidth + 15;
                carousel.scrollTo({
                    left: cardWidth * currentNewsIndex,
                    behavior: 'smooth'
                });
            }
        }

        function nextNews() {
            scrollToNews(currentNewsIndex + 1);
            resetNewsTimer();
        }

        function prevNews() {
            scrollToNews(currentNewsIndex - 1);
            resetNewsTimer();
        }

        function startNewsAutoScroll() {
            newsAutoTimer = setInterval(() => {
                scrollToNews(currentNewsIndex + 1);
            }, 5000); // Avanzamento automatico ogni 5 secondi
        }

        function resetNewsTimer() {
            clearInterval(newsAutoTimer);
            startNewsAutoScroll();
        }

        // Rilevamento swipe/touch
        document.getElementById('newsCarousel').addEventListener('touchstart', resetNewsTimer);

        // Scroll Animazioni 
        function reveal() { 
            var reveals = document.querySelectorAll(".reveal"); 
            for (var i = 0; i < reveals.length; i++) { 
                var windowHeight = window.innerHeight; 
                var elementTop = reveals[i].getBoundingClientRect().top; 
                var elementVisible = 50; 
                
                if (elementTop < windowHeight - elementVisible) { 
                    reveals[i].classList.add("active"); 
                } 
            } 
        } 

        window.addEventListener("scroll", reveal); 

        document.addEventListener('DOMContentLoaded', () => { 
            setLanguage('it'); 
            loadLiveWeather(); 
            loadLiveNews();
            reveal(); 
        }); 
    </script> 
</body> 
</html>
